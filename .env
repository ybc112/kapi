# ───────── 卡皮巴拉游戏（链上部分）─────────
# 游戏代币：卡皮巴拉 CAPY（普通 ERC20，18 位小数，无税、无开盘锁）
VITE_GAME_TOKEN_ADDRESS=0x839578f40b9a79a3fe891dd96079f3083e6e7777
# CapyGameVault 合约（BSC 主网，已在 BscScan 开源）
VITE_GAME_VAULT_ADDRESS=0x7DbF817d49ae053EDc5F205a81Bb2b08422C5F0C

# ───────── 游戏后端地址 ─────────
# 走 Cloudflare 隧道（capy.kimi-vault.com → localhost:8793），
# 服务器主动外连 Cloudflare，比 Vercel 反代（东京节点连中国 IP）稳定得多。
# 隧道入口在 Cloudflare Zero Trust → Networks → Tunnels → Public Hostname。
VITE_GAME_SIGNER_URL=https://capy.kimi-vault.com
